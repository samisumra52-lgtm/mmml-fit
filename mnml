            font-weight: 300;
            letter-spacing: 0.35em;
            color: #6a6058;
            text-transform: uppercase;
            margin-top: 8px;
        }

        .divider {
            width: 40px;
            height: 1px;
            background: linear-gradient(90deg, transparent, #c9a96e, transparent);
        }

        .socials {
            display: flex;
            gap: 28px;
            align-items: center;
        }

        .social-link {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 7px;
            text-decoration: none;
            color: #6a6058;
            font-size: 0.6rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            transition: color 0.3s ease;
        }

        .social-link:hover {
            color: #c9a96e;
        }

        .social-icon {
            width: 38px;
            height: 38px;
            border: 1px solid #222;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: border-color 0.3s ease;
        }

        .social-link:hover .social-icon {
            border-color: #c9a96e;
        }

        .social-icon svg {
            width: 15px;
            height: 15px;
            fill: currentColor;
        }

        .links-section {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .section-label {
            font-size: 0.58rem;
            letter-spacing: 0.35em;
            color: #3a3530;
            text-transform: uppercase;
            text-align: center;
            margin-bottom: 6px;
        }

        .link-btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 22px;
            background: #111;
            border: 1px solid #1c1c1c;
            border-radius: 2px;
            text-decoration: none;
            color: #c8bfb0;
            font-size: 0.72rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            font-weight: 300;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .link-btn::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 2px;
            background: #c9a96e;
            transform: scaleY(0);
            transition: transform 0.3s ease;
        }

        .link-btn:hover {
            background: #161616;
            border-color: #282828;
            color: #c9a96e;
        }

        .link-btn:hover::before {
            transform: scaleY(1);
        }

        .link-btn-label {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .platform-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #c9a96e;
            opacity: 0.5;
            flex-shrink: 0;
        }

        .link-btn-arrow {
            font-size: 0.8rem;
            color: #3a3530;
            transition: color 0.3s ease, transform 0.3s ease;
        }

        .link-btn:hover .link-btn-arrow {
            color: #c9a96e;
            transform: translateX(4px);
        }

        .footer {
            font-size: 0.58rem;
            color: #2e2a26;
            letter-spacing: 0.2em;
            text-align: center;
        }
    </style>
